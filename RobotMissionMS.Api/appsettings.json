{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "RefreshTokenDays": 7
  },
  "Mqtt": {
    "Enabled": false,
    "Port": 1883,
    "UseTls": false,
    "ClientId": "rmms-backend",
    "BatchSize": 10,
    "PollIntervalSeconds": 2,
    "LockSeconds": 30,
    "MaxAttempts": 5
  }
}
